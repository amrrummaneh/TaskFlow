@using Microsoft.AspNetCore.Identity
@using TaskFlow.Models
@inject SignInManager<ApplicationUser> SignInManager

@{
    ViewData["Title"] = "Home";
}

<div class="text-center py-5">
    <i class="bi bi-check2-square" style="font-size: 3.5rem; color: var(--tf-navy);"></i>
    <h1 class="display-4 fw-bold mt-3" style="color: var(--tf-navy);">TaskFlow</h1>
    <p class="lead mb-4" style="color: var(--tf-text-muted);">
        Organize projects, assign tasks, and track progress — all in one place.
    </p>

    @if (!SignInManager.IsSignedIn(User))
    {
        <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-tf-primary btn-lg me-2">
            <i class="bi bi-box-arrow-in-right me-1"></i>Login
        </a>
        <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-tf-outline btn-lg">
            <i class="bi bi-person-plus me-1"></i>Register
        </a>
    }
    else if (User.IsInRole(SD.Role_Admin))
    {
        <a asp-controller="Project" asp-action="Index" class="btn btn-tf-primary btn-lg">
            <i class="bi bi-kanban me-1"></i>Go to Projects
        </a>
    }
    else
    {
        <p style="color: var(--tf-text-muted);">Head to your dashboard once it's ready.</p>
    }
</div>

<div class="container mb-5">
    <div class="row g-4">
        <div class="col-md-4">
            <div class="card h-100 text-center border-0 shadow-sm" style="background-color: #fffdf9;">
                <div class="card-body py-4">
                    <i class="bi bi-kanban" style="font-size: 2rem; color: var(--tf-navy);"></i>
                    <h5 class="card-title mt-3" style="color: var(--tf-navy);">Manage Projects</h5>
                    <p class="card-text" style="color: var(--tf-text-muted);">
                        Create and organize projects with clear descriptions and timelines.
                    </p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 text-center border-0 shadow-sm" style="background-color: #fffdf9;">
                <div class="card-body py-4">
                    <i class="bi bi-list-task" style="font-size: 2rem; color: var(--tf-navy);"></i>
                    <h5 class="card-title mt-3" style="color: var(--tf-navy);">Assign Tasks</h5>
                    <p class="card-text" style="color: var(--tf-text-muted);">
                        Break projects into tasks and assign them to team members.
                    </p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 text-center border-0 shadow-sm" style="background-color: #fffdf9;">
                <div class="card-body py-4">
                    <i class="bi bi-graph-up" style="font-size: 2rem; color: var(--tf-navy);"></i>
                    <h5 class="card-title mt-3" style="color: var(--tf-navy);">Track Progress</h5>
                    <p class="card-text" style="color: var(--tf-text-muted);">
                        Follow up on task status and stay on top of deadlines.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>