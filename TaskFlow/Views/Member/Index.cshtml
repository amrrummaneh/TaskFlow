@using Microsoft.AspNetCore.Identity
@using TaskFlow.Models
@inject SignInManager<ApplicationUser> SignInManager

@{
    ViewData["Title"] = "Home";
}

<div class="text-center py-5">
    <h1 class="display-3 fw-bold" style="color: var(--tf-navy);">TaskFlow</h1>
    <p class="lead mb-4" style="color: var(--tf-text-muted);">Organize projects, assign tasks, and track progress — all in one place.</p>

    @if (!SignInManager.IsSignedIn(User))
    {
        <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-tf-primary btn-lg me-2">Login</a>
        <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-tf-outline btn-lg">Register</a>
    }
    else if (User.IsInRole(SD.Role_Admin))
    {
        <a asp-controller="Project" asp-action="Index" class="btn btn-tf-primary btn-lg">Go to Projects</a>
    }
    else
    {
        <p style="color: var(--tf-text-muted);">Head to your dashboard once it's ready.</p>
    }
</div>