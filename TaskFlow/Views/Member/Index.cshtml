@model IEnumerable<TaskFlow.Models.TaskItem>

<div class="container mt-4">
    <h2>My Tasks</h2>

    <div class="row">
        @foreach (var task in Model)
        {
            <div class="col-md-4 mb-3">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title">@task.Title</h5>
                        <p class="card-text">@task.Description</p>
                        <p class="mb-1"><strong>Project:</strong> @task.Project?.Name</p>
                        <p class="mb-1"><strong>Priority:</strong> @task.Priority</p>
                        <p class="mb-1"><strong>Due:</strong> @task.DueDate.ToString("MMM dd, yyyy")</p>

                        <form asp-action="UpdateStatus" method="post" class="mt-2">
                            <input type="hidden" name="id" value="@task.Id" />
                            <select name="status" class="form-select form-select-sm mb-2">
                                <option value="Pending" selected="@(task.Status == "Pending")">Pending</option>
                                <option value="InProgress" selected="@(task.Status == "InProgress")">InProgress</option>
                                <option value="Done" selected="@(task.Status == "Done")">Done</option>
                            </select>
                            <button type="submit" class="btn btn-primary btn-sm">Update Status</button>
                        </form>

                        <a asp-controller="TaskItem" asp-action="Details" asp-route-id="@task.Id" class="btn btn-outline-secondary btn-sm mt-2">View Comments</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>