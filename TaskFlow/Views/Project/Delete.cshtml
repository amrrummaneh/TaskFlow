@model TaskFlow.Models.Project

<div class="container mt-4">
    <h2 style="color: var(--tf-navy);"><i class="bi bi-exclamation-triangle me-2"></i>Delete Project</h2>
    <input asp-for="Id" type="hidden" />
    <form asp-action="Delete" method="post">
        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" disabled class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" disabled class="form-control" rows="4"></textarea>
        </div>

        <button type="submit" class="btn btn-danger">
            <i class="bi bi-trash3 me-1"></i>Delete
        </button>
        <a asp-action="Index" class="btn btn-tf-outline">
            <i class="bi bi-arrow-left me-1"></i>Back
        </a>
    </form>
</div>