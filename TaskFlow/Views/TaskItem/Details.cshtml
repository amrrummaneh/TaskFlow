@model TaskFlow.Models.TaskItem
@using System.Security.Claims

<div class="container mt-4">
    <div class="card mb-4">
        <div class="card-body">
            <h2>@Model.Title</h2>
            <p>@Model.Description</p>
            <p class="mb-1"><strong>Project:</strong> @Model.Project?.Name</p>
            <p class="mb-1"><strong>Assigned to:</strong> @Model.AssignedUser?.Name</p>
            <p class="mb-1"><strong>Priority:</strong> @Model.Priority</p>
            <p class="mb-1"><strong>Status:</strong> @Model.Status</p>
            <p class="mb-1"><strong>Due:</strong> @Model.DueDate.ToString("MMM dd, yyyy")</p>
        </div>
    </div>

    <h4>Comments</h4>

    @foreach (var comment in ViewBag.Comments)
    {
        <div class="border rounded p-2 mb-2">
            <div class="d-flex justify-content-between">
                <strong>@comment.Author?.Name</strong>
                <small class="text-muted">@comment.CreatedAt.ToString("MMM dd, yyyy HH:mm")</small>
            </div>
            <p class="mb-1">@comment.Content</p>

            <form asp-controller="Comment" asp-action="Delete" method="post">
                <input type="hidden" name="id" value="@comment.Id" />
                <input type="hidden" name="taskItemId" value="@Model.Id" />
                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
            </form>
        </div>
    }

    <form asp-controller="Comment" asp-action="Create" method="post" class="mt-3">
        <input type="hidden" name="TaskItemId" value="@Model.Id" />
        <input type="hidden" name="AuthorId" value="@User.FindFirstValue(System.Security.Claims.ClaimTypes.NameIdentifier)" />

        <div class="mb-2">
            <textarea name="Content" class="form-control" rows="2" placeholder="Add a comment..." required></textarea>
        </div>
        <button type="submit" class="btn btn-primary btn-sm">Post Comment</button>
    </form>

    <a asp-action="Index" class="btn btn-secondary mt-3">Back to Tasks</a>
</div>