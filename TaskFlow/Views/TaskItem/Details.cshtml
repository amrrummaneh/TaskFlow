@model TaskFlow.Models.TaskItem
@using System.Security.Claims

<div class="container mt-4">
    <div class="card mb-4" style="border-color: var(--tf-beige-soft);">
        <div class="card-body">
            <h2 style="color: var(--tf-navy);">@Model.Title</h2>
            <p style="color: var(--tf-text-muted);">@Model.Description</p>

            <p class="mb-1"><i class="bi bi-kanban me-1"></i><strong>Project:</strong> @Model.Project?.Name</p>
            <p class="mb-1"><i class="bi bi-person me-1"></i><strong>Assigned to:</strong> @Model.AssignedUser?.Name</p>

            <p class="mb-1">
                <i class="bi bi-flag me-1"></i><strong>Priority:</strong>
                @{
                    var priorityClass = Model.Priority switch
                    {
                        "High" => "bg-danger",
                        "Medium" => "bg-warning text-dark",
                        _ => "bg-secondary"
                    };
                }
                <span class="badge @priorityClass">@Model.Priority</span>
            </p>

            <p class="mb-1">
                <i class="bi bi-activity me-1"></i><strong>Status:</strong>
                @{
                    var statusClass = Model.Status switch
                    {
                        "Done" => "bg-success",
                        "InProgress" => "bg-info text-dark",
                        _ => "bg-secondary"
                    };
                }
                <span class="badge @statusClass">@Model.Status</span>
            </p>

            <p class="mb-1"><i class="bi bi-calendar3 me-1"></i><strong>Due:</strong> @Model.DueDate.ToString("MMM dd, yyyy")</p>
        </div>
    </div>

    <h4 style="color: var(--tf-navy);"><i class="bi bi-chat-left-text me-2"></i>Comments</h4>

    @foreach (var comment in ViewBag.Comments)
    {
        <div class="border rounded p-2 mb-2" style="border-color: var(--tf-beige-soft) !important; background-color: #fffdf9;">
            <div class="d-flex justify-content-between">
                <strong style="color: var(--tf-navy);">@comment.Author?.Name</strong>
                <small class="text-muted">@comment.CreatedAt.ToString("MMM dd, yyyy HH:mm")</small>
            </div>
            <p class="mb-1">@comment.Content</p>

            <form asp-controller="Comment" asp-action="Delete" method="post">
                <input type="hidden" name="id" value="@comment.Id" />
                <input type="hidden" name="taskItemId" value="@Model.Id" />
                <button type="submit" class="btn btn-sm btn-outline-danger">
                    <i class="bi bi-trash3"></i>
                </button>
            </form>
        </div>
    }

    <form asp-controller="Comment" asp-action="Create" method="post" class="mt-3">
        <input type="hidden" name="TaskItemId" value="@Model.Id" />
        <input type="hidden" name="AuthorId" value="@User.FindFirstValue(System.Security.Claims.ClaimTypes.NameIdentifier)" />

        <div class="mb-2">
            <textarea name="Content" class="form-control" rows="2" placeholder="Add a comment..." required></textarea>
        </div>
        <button type="submit" class="btn btn-tf-primary btn-sm">
            <i class="bi bi-send me-1"></i>Post Comment
        </button>
    </form>

    <a asp-action="Index" class="btn btn-tf-outline mt-3">
        <i class="bi bi-arrow-left me-1"></i>Back to Tasks
    </a>
</div>