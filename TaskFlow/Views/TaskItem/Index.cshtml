@model IEnumerable<TaskFlow.Models.TaskItem>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Tasks</h2>
        <a asp-action="Create" class="btn btn-primary">Add Task</a>
    </div>

    <div class="row">
        @foreach (var task in Model)
        {
            <div class="col-md-4 mb-3">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title">@task.Title</h5>
                        <p class="card-text">@task.Description</p>
                        <p class="mb-1"><strong>Project:</strong> @task.Project?.Name</p>
                        <p class="mb-1"><strong>Assigned to:</strong> @task.AssignedUser?.Name</p>
                        <p class="mb-1"><strong>Priority:</strong> @task.Priority</p>
                        <p class="mb-1"><strong>Status:</strong> @task.Status</p>
                    </div>
                    <div class="card-footer d-flex justify-content-between align-items-center">
                        <small class="text-muted">Due @task.DueDate.ToString("MMM dd, yyyy")</small>
                        <div>
                            <a asp-action="Edit" asp-route-id="@task.Id" class="btn btn-warning btn-sm">Edit</a>
                            <a asp-action="Delete" asp-route-id="@task.Id" class="btn btn-danger btn-sm">Delete</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>