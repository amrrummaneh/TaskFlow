@model IEnumerable<TaskFlow.Models.TaskItem>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 style="color: var(--tf-navy);"><i class="bi bi-list-task me-2"></i>Tasks</h2>
        <a asp-action="Create" class="btn btn-tf-primary">
            <i class="bi bi-plus-lg me-1"></i>Add Task
        </a>
    </div>

    <div class="row">
        @foreach (var task in Model)
        {
            <div class="col-md-4 mb-3">
                <div class="card h-100" style="border-color: var(--tf-beige-soft);">
                    <div class="card-body">
                        <h5 class="card-title" style="color: var(--tf-navy);">@task.Title</h5>
                        <p class="card-text" style="color: var(--tf-text-muted);">@task.Description</p>

                        <p class="mb-1"><i class="bi bi-kanban me-1"></i><strong>Project:</strong> @task.Project?.Name</p>
                        <p class="mb-1"><i class="bi bi-person me-1"></i><strong>Assigned to:</strong> @task.AssignedUser?.Name</p>

                        <p class="mb-1">
                            <i class="bi bi-flag me-1"></i><strong>Priority:</strong>
                            @{
                                var priorityClass = task.Priority switch
                                {
                                    "High" => "bg-danger",
                                    "Medium" => "bg-warning text-dark",
                                    _ => "bg-secondary"
                                };
                            }
                            <span class="badge @priorityClass">@task.Priority</span>
                        </p>

                        <p class="mb-1">
                            <i class="bi bi-activity me-1"></i><strong>Status:</strong>
                            @{
                                var statusClass = task.Status switch
                                {
                                    "Done" => "bg-success",
                                    "InProgress" => "bg-info text-dark",
                                    _ => "bg-secondary"
                                };
                            }
                            <span class="badge @statusClass">@task.Status</span>
                        </p>
                    </div>
                    <div class="card-footer d-flex justify-content-between align-items-center" style="background-color: var(--tf-beige-soft);">
                        <small class="text-muted"><i class="bi bi-calendar3 me-1"></i>Due @task.DueDate.ToString("MMM dd, yyyy")</small>
                        <div>
                            <a asp-action="Details" asp-route-id="@task.Id" class="btn btn-tf-outline btn-sm">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a asp-action="Edit" asp-route-id="@task.Id" class="btn btn-tf-outline btn-sm">
                                <i class="bi bi-pencil-square"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@task.Id" class="btn btn-outline-danger btn-sm">
                                <i class="bi bi-trash3"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>